{"questions": [{"id": "Q01", "rule": "开洞", "title": "冷水管穿过基础墙", "hl": ["2h405XijT83A$BX7w5ki6u"], "ctx": ["2O2Fr$t4X7Zf8NOew3FK04"], "ask": "这里要在基础墙上预留洞吗？", "box": [[0.417, -1.25, 9.267], [4.617, 0.0, 10.266]], "where": "一楼地面以下约半米", "why": "基础墙是先浇的混凝土。要是没提前留洞，水管来了只能凿墙，既费事又伤结构。", "yes": "要留洞", "no": "不用留洞", "parts": [["2h405XijT83A$BX7w5ki6u", "冷水进户管", 0, [1.8225, -0.327, 9.7665], [[1.81, -0.473, 9.267], [1.835, -0.447, 10.266]]], ["2O2Fr$t4X7Zf8NOew3FK04", "混凝土基础墙", 9, [2.517, 0.12, 10.0], [[0.417, -1.25, 9.782], [4.617, 0.0, 10.218]]]], "joints": [], "chain": "室外自来水 → 冷水进户管 → 穿过基础墙 → 屋里各个水龙头", "did": "发现这根管子有 21 厘米在基础墙里面，判定：基础墙上要预留一个洞（套管）。"}, {"id": "Q02", "rule": "开洞", "title": "排水通气管穿出屋顶", "hl": ["2h405XijT83A$BX7w5kiAI"], "ctx": ["3ThA22djr8AQQ9eQMA5s7I"], "ask": "屋顶这里要开洞并做防水吗？", "box": [[0.417, 2.756, 0.417], [8.383, 6.559, 17.383]], "where": "屋顶", "why": "屋顶开洞不做防水，下雨就漏。所以盖屋顶时就要知道这里有根管子要穿出去。", "yes": "要开洞并防水", "no": "不用", "parts": [["2h405XijT83A$BX7w5kiAI", "排水通气管", 0, [4.707, 6.679, 7.281], [[4.683, 2.756, 7.257], [4.731, 6.559, 7.305]]], ["3ThA22djr8AQQ9eQMA5s7I", "屋顶", 9, [4.3999999999999995, 6.577, 8.9], [[0.417, 6.0, 0.417], [8.383, 6.457, 17.383]]]], "joints": [], "chain": "二楼马桶、洗手盆的下水 → 通气管一路向上 → 穿出屋顶透气（防止下水道臭气和水封被抽干）", "did": "发现这根管子穿过屋顶，判定：屋顶要开洞，开洞处要做防水。"}, {"id": "Q03", "rule": "开洞", "title": "暖气管藏在墙的夹层里", "hl": ["06CUoaeF1B6wv_rVmaqG6N"], "ctx": ["0iEHWY1$XA8eQeeULq4jE6"], "ask": "管子藏在空心墙里走，算「要开洞」吗？", "box": [[0.417, 0.0, 10.218], [4.618, 2.795, 10.37]], "where": "一楼，离地约 2.6 米，外墙内侧", "why": "电脑把 606 处都算成「要开洞」。如果这类其实是正常暗装，606 会少一大截，真正要开洞的才看得清。", "yes": "要算开洞", "no": "正常暗装，不算", "parts": [["06CUoaeF1B6wv_rVmaqG6N", "暖气管", 0, [3.6574999999999998, 2.795, 10.2395], [[3.338, 2.642, 10.223], [3.977, 2.675, 10.256]]], ["0iEHWY1$XA8eQeeULq4jE6", "龙骨夹层墙", 9, [2.5175, 2.915, 10.294], [[0.417, 0.0, 10.218], [4.618, 2.795, 10.37]]]], "joints": [], "chain": "锅炉 → 暖气管顺着墙走 → 各房间暖气片。这段管子不是穿墙，而是顺着墙、在空心夹层里走", "did": "目前把它也算成「要开洞」。我怀疑不该算：龙骨墙本来就是空心的，管子藏里面是正常暗装。"}, {"id": "Q04", "rule": "开洞", "title": "暖气弯头埋进砖外墙", "hl": ["01S9djs61BFfnHKPIUF5My"], "ctx": ["2O2Fr$t4X7Zf8NOew3FNhv"], "ask": "要在砖外墙上开槽装这个弯头吗？", "box": [[0.0, 0.0, 0.417], [0.417, 3.1, 17.383]], "where": "一楼，外墙内侧，离地 2.7 米", "why": "砖外墙开槽要提前安排，也会削弱墙。如果只是画图误差，就不该当成问题报出来。", "yes": "要开槽", "no": "画图误差，不用开槽", "parts": [["01S9djs61BFfnHKPIUF5My", "暖气管弯头", 0, [0.389, 2.883, 11.4145], [[0.372, 2.734, 11.397], [0.406, 2.763, 11.432]]], ["2O2Fr$t4X7Zf8NOew3FNhv", "砖砌外墙", 9, [0.2085, 3.22, 8.9], [[0.0, 0.0, 0.417], [0.417, 3.1, 17.383]]]], "joints": [], "chain": "暖气管沿外墙内侧走，到墙角用这个弯头拐弯", "did": "发现弯头有 4.5 厘米画进了砖墙里，判定：外墙要开槽。也可能只是画图时多画进去一点。"}, {"id": "Q05", "rule": "谁撑着谁", "title": "一楼悬在半空的隔墙", "hl": ["1aj$VJZFn2TxepZUBcKpee", "1aj$VJZFn2TxepZUBcKphf", "2O2Fr$t4X7Zf8NOew3FL8v", "2O2Fr$t4X7Zf8NOew3FLTF"], "ctx": [], "ask": "这 4 段墙悬空，是正常的吗？", "box": [[0.417, 2.612, 6.126], [8.383, 6.0, 11.674]], "where": "一楼，离地 2.6 米以上", "why": "电脑排施工顺序要靠「谁撑着谁」。认不出撑它的东西，就会把它排错批次。", "yes": "正常的吊墙，电脑该认出是楼板吊着", "no": "模型画错了", "parts": [["1aj$VJZFn2TxepZUBcKpee", "悬空隔墙 1", 0, [1.4929999999999999, 3.22, 7.9875], [[1.431, 2.612, 6.25], [1.555, 3.1, 9.725]]], ["1aj$VJZFn2TxepZUBcKphf", "悬空隔墙 2", 1, [7.307, 3.22, 9.8125], [[7.245, 2.612, 8.075], [7.369, 3.1, 11.55]]], ["2O2Fr$t4X7Zf8NOew3FL8v", "悬空隔墙 3", 2, [7.3385, 6.12, 11.612], [[6.294, 2.612, 11.55], [8.383, 6.0, 11.674]]], ["2O2Fr$t4X7Zf8NOew3FLTF", "悬空隔墙 4", 3, [1.4614999999999998, 6.12, 6.188000000000001], [[0.417, 2.612, 6.126], [2.506, 6.0, 6.25]]]], "joints": [], "chain": "这 4 段墙底边离地 2.6 米，顶到二楼楼板，下面是空的（像门洞、走道上方那一截封墙）", "did": "在它们下面没找到任何墙或楼板，判定：「没有东西撑着」。"}, {"id": "Q06", "rule": "谁撑着谁", "title": "钢梁搭在墙上", "hl": ["2OrWItJ6zAwBNp0OUxK$8W"], "ctx": [], "ask": "这根钢梁是靠两头的墙撑着吗？", "box": [[0.267, 2.693, 17.434], [6.448, 3.1, 17.612]], "where": "一楼顶上", "why": "认不出梁搁在墙上，后面的施工顺序就会错（见第 10 题）。", "yes": "是墙撑着", "no": "不是墙撑着", "parts": [["2OrWItJ6zAwBNp0OUxK$8W", "钢梁", 0, [3.3575000000000004, 3.22, 17.523], [[0.267, 2.693, 17.434], [6.448, 3.1, 17.612]]]], "joints": [], "chain": "钢梁横跨约 6 米，在一楼顶上，用来托住二楼楼板", "did": "没找到撑着它的东西，判定：「无支承」。我怀疑它两头搁在墙上，只是电脑还不会认「梁头搁墙顶」。"}, {"id": "Q07", "rule": "管子怎么连", "title": "淋浴房和变径接头", "hl": ["2h405XijT83A$BX7w5ki4p", "12378IiXHC3hYBtFOTiF2Q", "3KiItGcXL9EgPZdQRTG4oS", "12378IiXHC3hYBtFOTiFP1"], "ctx": [], "ask": "冷热水接头和淋浴房之间，真的有管子直接连着吗？", "box": [[3.165, 0.0, 8.91], [4.034, 1.829, 9.725]], "where": "一楼卫生间", "why": "原模型很多连接没记。电脑靠「挨得近」自己补上。补错了，就会以为水能流过去，其实不通。", "yes": "有，连着", "no": "没有，水是经龙头出来的", "parts": [["2h405XijT83A$BX7w5ki4p", "淋浴房（接水的底盆和隔断）", 0, [3.5975, 1.9489999999999998, 9.317499999999999], [[3.165, 0.0, 8.91], [4.03, 1.829, 9.725]]], ["12378IiXHC3hYBtFOTiF2Q", "热水管变径接头", 1, [4.032, 0.95, 9.2895], [[4.03, 0.814, 9.282], [4.034, 0.83, 9.297]]], ["3KiItGcXL9EgPZdQRTG4oS", "冷水管变径接头", 2, [4.032, 0.95, 9.34], [[4.03, 0.814, 9.332], [4.034, 0.83, 9.348]]], ["12378IiXHC3hYBtFOTiFP1", "淋浴龙头", 4, [3.9090000000000003, 1.7730000000000001, 9.315000000000001], [[3.785, 0.733, 9.226], [4.033, 1.653, 9.404]]]], "joints": [[[4.005, 0.458, 9.124], "电脑补的连接 A", ["12378IiXHC3hYBtFOTiF2Q", "2h405XijT83A$BX7w5ki4p"]], [[4.005, 0.458, 9.508], "电脑补的连接 B", ["2h405XijT83A$BX7w5ki4p", "3KiItGcXL9EgPZdQRTG4oS"]]], "chain": "热水管 → 热水变径接头 → 淋浴龙头；冷水管 → 冷水变径接头 → 淋浴龙头（模型本来就记了）。淋浴房底盆另接下水管", "did": "又把两个变径接头和淋浴房连在了一起（黄圈 A、B），两者相距约 0.8 米。"}, {"id": "Q08", "rule": "管子怎么连", "title": "自来水接暖气的倒流防止器", "hl": ["2gWwY8cwDExg6tt0HBFvQn", "2gWwY8cwDExg6tt0HBFubX", "2gWwY8cwDExg6tt0HBFuWf"], "ctx": [], "ask": "冷水管甲、乙应该分别接在这个阀的两头吗？", "box": [[5.45, 3.236, 7.22], [5.545, 3.362, 7.623]], "where": "二楼，锅炉补水处", "why": "这个阀防止暖气脏水倒灌进自来水。接错或漏接，是饮水安全问题。", "yes": "对，一进一出", "no": "不对", "parts": [["2gWwY8cwDExg6tt0HBFvQn", "倒流防止器（阀）", 0, [5.4975000000000005, 3.482, 7.423], [[5.45, 3.236, 7.243], [5.545, 3.362, 7.603]]], ["2gWwY8cwDExg6tt0HBFubX", "冷水管 甲", 1, [5.4825, 3.394, 7.6129999999999995], [[5.47, 3.248, 7.603], [5.495, 3.274, 7.623]]], ["2gWwY8cwDExg6tt0HBFuWf", "冷水管 乙", 2, [5.4830000000000005, 3.394, 7.2315000000000005], [[5.47, 3.248, 7.22], [5.496, 3.274, 7.243]]]], "joints": [[[5.469, 3.258, 7.243], "电脑补的连接 A", ["2gWwY8cwDExg6tt0HBFuWf", "2gWwY8cwDExg6tt0HBFvQn"]], [[5.484, 3.274, 7.603], "电脑补的连接 B", ["2gWwY8cwDExg6tt0HBFubX", "2gWwY8cwDExg6tt0HBFvQn"]]], "chain": "自来水 → 冷水管甲 → 倒流防止器 → 冷水管乙 → 给锅炉补水。这个阀只许水往锅炉流，不许暖气水倒流回自来水", "did": "原模型没记阀和两根管的连接。电脑发现管口和阀口只差 1–2 毫米，就补上了这两处连接（黄圈 A、B）。"}, {"id": "Q09", "rule": "管子怎么连", "title": "地下断头的排水管", "hl": ["06tz$4Kfr6hxOdBtBn_Zg8"], "ctx": ["2O2Fr$t4X7Zf8NOew3FKE5"], "ask": "这根管是漏画了，还是本来就该通到室外？", "box": [[-0.072, -1.25, 0.417], [3.231, 0.0, 17.383]], "where": "地下约 0.7 米，基础墙外侧", "why": "管子断头可能是漏画，也可能只是模型画到房子边为止。分不清，电脑会乱报问题。", "yes": "漏画", "no": "正常，是通往室外的出户管", "parts": [["06tz$4Kfr6hxOdBtBn_Zg8", "PVC 排水管", 0, [1.5795, -0.583, 10.121500000000001], [[-0.072, -0.736, 10.105], [3.231, -0.703, 10.138]]], ["2O2Fr$t4X7Zf8NOew3FKE5", "基础墙", 9, [0.2085, 0.12, 8.9], [[0.0, -1.25, 0.417], [0.417, 0.0, 17.383]]]], "joints": [], "chain": "屋里的下水 → 汇到这根 PVC 管 → 出了基础墙就没了", "did": "发现这根管的一头什么也没接，报「断头」。"}, {"id": "Q10", "rule": "先后顺序", "title": "二楼钢梁排在第 1 批", "hl": ["2OrWItJ6zAwBNp0OUxK$Bq", "2OrWItJ6zAwBNp0OUxK$CR", "2OrWItJ6zAwBNp0OUxK$Dw", "2OrWItJ6zAwBNp0OUxK$Dx"], "ctx": [], "batches": true, "ask": "二楼顶的梁跟基础一起第 1 批装，行吗？", "box": [[0.178, 5.593, 0.182], [8.622, 6.0, 17.618]], "where": "二楼顶上", "why": "梁要等下面的墙立起来才能架上去。顺序排错，现场照着做就会出事。", "yes": "可以一起装", "no": "不对，得等墙立起来", "parts": [["2OrWItJ6zAwBNp0OUxK$Bq", "二楼顶钢梁", 0, [0.267, 6.12, 15.462499999999999], [[0.178, 5.593, 13.402], [0.356, 6.0, 17.523]]], ["2OrWItJ6zAwBNp0OUxK$CR", "二楼顶钢梁", 0, [6.479, 6.12, 17.529], [[4.429, 5.593, 17.44], [8.529, 6.0, 17.618]]], ["2OrWItJ6zAwBNp0OUxK$Dw", "二楼顶钢梁", 0, [2.321, 6.12, 0.271], [[0.271, 5.593, 0.182], [4.371, 6.0, 0.36]]], ["2OrWItJ6zAwBNp0OUxK$Dx", "二楼顶钢梁", 0, [8.533000000000001, 6.12, 2.3375], [[8.444, 5.593, 0.277], [8.622, 6.0, 4.398]]]], "joints": [], "chain": "施工一般是：基础 → 一楼墙 → 一楼顶的梁和楼板 → 二楼墙 → 二楼顶的梁 → 屋顶", "did": "把整栋楼排成 9 批（左下角可播放）。因为没认出谁撑着这几根梁（见第 6 题），把它们排进了第 1 批，跟基础一起。"}], "batches